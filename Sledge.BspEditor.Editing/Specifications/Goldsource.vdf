Specification
{
	ID "Matrix2"
	Name "Matrix Engine 2 Compiler"
	Engine "Goldsource"
	
	Preset
	{
		Name "Default"
		Description "Compile the map using the standard settings"
		Arguments
		{
			COMPILER ""
		}
	}

	Tool
	{
		Name "PreTool"
		Description "Commands before compilation"
		Order "0"
		Enabled "True"
		Custom "True"
	}

	Tool
	{
		Name "COMPILER"
		Description "Matrix Engine 2 Map Compiler"
		Order "1"
		Enabled "True"

		Parameter
		{
			Name "Day Stage"
			Flag "-daystage"
			Description "Select day stage (e.g. daylightreturn)"
			Type "Choice"
			Value ""
			Options "Default,Day Light Return"
			OptionValues " ,daylightreturn"
		}
	}

	Tool
	{
		Name "PostTool"
		Description "Commands after compilation"
		Order "2"
		Enabled "True"
		Custom "True"
	}
}